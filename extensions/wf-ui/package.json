{
  "name": "@zingspark/wf-extension-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Optional Harness UI/browser control extension for wf-ui.",
  "bin": {
    "wf-ui": "bin/wf-ui.js"
  },
  "files": [
    "bin/",
    "docs/",
    "package.json"
  ],
  "dependencies": {
    "create-harness-vibe-coding": "^0.9.5"
  },
  "engines": {
    "node": ">=18"
  },
  "harnessExtension": {
    "id": "wf-ui",
    "capabilities": ["ui.control", "browser.control", "ui.server"],
    "defaultInstall": false
  }
}
